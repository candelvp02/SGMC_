@model SGMC.Application.Dto.Users.ResetPasswordDto
@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SGMC</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4">

    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-indigo-600 rounded-2xl mb-4 shadow-lg">
                <i class="fas fa-shield-halved text-white text-2xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">SGMC</h1>
            <p class="text-gray-500 mt-1 text-sm">Establecer nueva contraseña</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8">

            <h2 class="text-xl font-semibold text-gray-700 mb-6">Nueva contraseña</h2>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-5">
                    <i class="fas fa-circle-exclamation"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <form asp-action="ResetPassword" asp-controller="Auth" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700 mb-1">
                        Nueva contraseña
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                            <i class="fas fa-lock text-sm"></i>
                        </span>
                        <input asp-for="NewPassword"
                               type="password"
                               placeholder="••••••••"
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500
                        transition duration-150" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">
                        Confirmar contraseña
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                            <i class="fas fa-lock text-sm"></i>
                        </span>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="••••••••"
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500
                        transition duration-150" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <button type="submit"
                        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold
                    py-2.5 rounded-lg text-sm transition duration-150 shadow-sm
                    flex items-center justify-center gap-2">
                    <i class="fas fa-floppy-disk"></i>
                    Guardar nueva contraseña
                </button>
            </form>
        </div>
    </div>
</body>
</html>