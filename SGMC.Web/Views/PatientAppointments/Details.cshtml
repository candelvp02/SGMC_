@model SGMC.Web.Models.Appointment.AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Detalle de Cita";

    var badgeClass = Model.StatusId switch
    {
        1 => "bg-yellow-100 text-yellow-800 border border-yellow-300",
        2 => "bg-green-100  text-green-800  border border-green-300",
        3 => "bg-red-100    text-red-800    border border-red-300",
        4 => "bg-blue-100   text-blue-800   border border-blue-300",
        _ => "bg-gray-100   text-gray-700"
    };
    var statusIcon = Model.StatusId switch
    {
        1 => "fas fa-clock",
        2 => "fas fa-check-circle",
        3 => "fas fa-times-circle",
        4 => "fas fa-check-double",
        _ => "fas fa-circle"
    };
    var headerGradient = Model.StatusId switch
    {
        1 => "from-yellow-500 to-yellow-400",
        2 => "from-green-600  to-green-500",
        3 => "from-red-600    to-red-500",
        4 => "from-blue-600   to-blue-500",
        _ => "from-gray-600   to-gray-500"
    };
    var canReschedule = Model.StatusId == 1 || Model.StatusId == 2;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <!-- Volver -->
    <a asp-controller="PatientAppointments" asp-action="Index"
       class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 mb-5 transition">
        <i class="fas fa-arrow-left"></i> Volver al historial
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

        <!-- Header con color según estado -->
        <div class="bg-gradient-to-r @headerGradient px-6 py-5 text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-white/70 text-xs uppercase tracking-wide mb-1">Cita #@Model.AppointmentId</p>
                    <h2 class="text-xl font-bold">@Model.AppointmentDateFormatted</h2>
                    <p class="text-white/80 text-sm mt-0.5">@Model.AppointmentTimeFormatted</p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold @badgeClass">
                    <i class="@statusIcon"></i> @Model.StatusName
                </span>
            </div>
        </div>

        <!-- Cuerpo del detalle -->
        <div class="divide-y divide-gray-100">

            <!-- Médico -->
            <div class="flex items-center gap-4 px-6 py-4">
                <div class="bg-blue-100 rounded-full p-3 flex-shrink-0">
                    <i class="fas fa-user-md text-blue-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Médico</p>
                    <p class="text-sm font-semibold text-gray-800">Dr. @Model.DoctorName</p>
                </div>
            </div>

            <!-- Fecha y hora -->
            <div class="flex items-center gap-4 px-6 py-4">
                <div class="bg-purple-100 rounded-full p-3 flex-shrink-0">
                    <i class="fas fa-calendar-day text-purple-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Fecha y Hora de la Cita</p>
                    <p class="text-sm font-semibold text-gray-800">@Model.AppointmentDateFormatted</p>
                    <p class="text-sm text-gray-500">@Model.AppointmentTimeFormatted</p>
                </div>
            </div>

            <!-- Fecha en que se agendó -->
            <div class="flex items-center gap-4 px-6 py-4">
                <div class="bg-gray-100 rounded-full p-3 flex-shrink-0">
                    <i class="fas fa-history text-gray-500 text-lg"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Fecha en que se agendó</p>
                    <p class="text-sm font-semibold text-gray-800">@Model.CreatedAt.ToString("dd 'de' MMMM 'de' yyyy, hh:mm tt")</p>
                </div>
            </div>

            <!-- Estado -->
            <div class="flex items-center gap-4 px-6 py-4">
                <div class="bg-green-100 rounded-full p-3 flex-shrink-0">
                    <i class="fas fa-info-circle text-green-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Estado actual</p>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold @badgeClass">
                        <i class="@statusIcon text-xs"></i> @Model.StatusName
                    </span>
                </div>
            </div>
        </div>

<!-- Acciones -->
        <div class="px-6 py-4 bg-gray-50 flex justify-end gap-3">
            @if (Model.CanCancel)
            {
                <button type="button" onclick="openCancelModal()"
                        class="inline-flex items-center gap-2 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-sm font-semibold py-2.5 px-5 rounded-lg transition">
                    <i class="fas fa-times-circle"></i> Cancelar cita
                </button>
            }
            @if (canReschedule)
            {
                <a asp-controller="PatientAppointments" asp-action="Reschedule" asp-route-id="@Model.AppointmentId"
                   class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-semibold py-2.5 px-5 rounded-lg transition shadow-sm">
                    <i class="fas fa-calendar-alt"></i> Reprogramar
                </a>
            }
            <a asp-controller="PatientAppointments" asp-action="Index"
               class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2.5 px-5 rounded-lg transition shadow-sm">
                <i class="fas fa-list"></i> Ver todas mis citas
            </a>
        </div>
    </div>
</div>

@if (Model.CanCancel)
{
    <!-- ═══ MODAL: Advertencia y Confirmación de Cancelación ═══ -->
    <div id="cancelModalOverlay"
         class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden">

            <!-- Header de advertencia -->
            <div class="bg-red-600 px-6 py-4 flex items-center gap-3">
                <i class="fas fa-exclamation-triangle text-white text-xl"></i>
                <h3 class="text-white font-bold text-lg">Confirmar cancelación</h3>
            </div>

            <div class="p-6">
                <div class="bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-lg px-4 py-3 mb-4 flex gap-2">
                    <i class="fas fa-info-circle mt-0.5"></i>
                    <span><strong>Esta acción no se puede deshacer.</strong> Al cancelar, el horario quedará liberado y se notificará al médico.</span>
                </div>

                <p class="text-sm text-gray-600 mb-2">Estás por cancelar tu cita con:</p>
                <div class="bg-gray-50 rounded-lg px-4 py-3 mb-5 text-sm">
                    <p class="font-semibold text-gray-800">Dr. @Model.DoctorName</p>
                    <p class="text-gray-500">@Model.AppointmentDateFormatted — @Model.AppointmentTimeFormatted</p>
                </div>

                <p class="text-sm text-gray-700 mb-5">¿Estás seguro de que deseas continuar?</p>

                <div class="flex justify-end gap-3">
                    <button type="button" onclick="closeCancelModal()"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold py-2.5 px-5 rounded-lg transition">
                        No, mantener cita
                    </button>
                    <form asp-controller="PatientAppointments" asp-action="CancelConfirmed"
                          asp-route-id="@Model.AppointmentId" method="post" id="cancelForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="btnConfirmCancel"
                                class="bg-red-600 hover:bg-red-700 text-white text-sm font-semibold py-2.5 px-5 rounded-lg transition">
                            <i class="fas fa-times-circle mr-1"></i> Sí, cancelar cita
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function openCancelModal() {
                document.getElementById('cancelModalOverlay').classList.remove('hidden');
            }
            function closeCancelModal() {
                document.getElementById('cancelModalOverlay').classList.add('hidden');
            }
            // Cerrar al hacer clic fuera del modal
            document.getElementById('cancelModalOverlay').addEventListener('click', function (e) {
                if (e.target === this) closeCancelModal();
            });
            // Evitar doble submit al confirmar
            document.getElementById('cancelForm').addEventListener('submit', function () {
                const btn = document.getElementById('btnConfirmCancel');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Cancelando...';
            });
        </script>
    }
}