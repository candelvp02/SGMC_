@model SGMC.Web.Models.Appointment.RescheduleAppointmentViewModel
@{
    ViewData["Title"] = "Reprogramar Cita";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-2xl font-bold text-blue-600 mb-1 flex items-center gap-2">
        <i class="fas fa-calendar-days"></i> Reprogramar Cita
    </h1>
    <p class="text-gray-500 mb-6">Selecciona una nueva fecha y hora disponible con el mismo médico.</p>

    @* Resumen de la cita actual *@
    <div class="flex justify-between items-center bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 mb-6">
        <div>
            <div class="font-semibold text-gray-800">@Model.DoctorName</div>
            <div class="text-gray-500 text-sm">
                Cita actual:
                @Model.CurrentAppointmentDate.ToString("dddd d 'de' MMMM, HH:mm", new System.Globalization.CultureInfo("es-DO"))
                — <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">@Model.CurrentStatusName</span>
            </div>
        </div>
    </div>

    @* Barra de progreso (2 pasos, el médico ya está fijo) *@
    <div class="flex items-center gap-2 mb-6">
        <div class="step-item active flex flex-col items-center gap-1" id="step-indicator-1">
            <span class="step-circle">1</span>
            <span class="step-label hidden md:inline">Nueva fecha y hora</span>
        </div>
        <div class="step-line flex-grow"></div>
        <div class="step-item flex flex-col items-center gap-1" id="step-indicator-2">
            <span class="step-circle">2</span>
            <span class="step-label hidden md:inline">Confirmar</span>
        </div>
    </div>

    <div id="alertContainer" class="mb-4"></div>

    @* ═══ PASO 1: Seleccionar nueva fecha y hora ═══ *@
    <div id="step1" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 mb-4">
        <div class="p-5">
            <h2 class="font-semibold text-gray-800 mb-4">Paso 1 — Selecciona la nueva fecha y hora</h2>

            <div class="mb-4">
                <label for="appointmentDate" class="block text-sm font-semibold text-gray-700 mb-1">Fecha</label>
                <input type="date" id="appointmentDate"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>

            <div id="slotsContainer" class="mt-3">
                <p class="text-gray-500 text-sm">Selecciona una fecha para ver los horarios disponibles del médico.</p>
            </div>

            <div class="mt-5 flex justify-between">
                <a asp-controller="PatientAppointments" asp-action="Details" asp-route-id="@Model.AppointmentId"
                   class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">
                    <i class="fas fa-arrow-left"></i> Cancelar
                </a>
                <button id="btnStep1Next" class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold py-2 px-4 rounded-lg transition" disabled>
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    @* ═══ PASO 2: Confirmar reprogramación ═══ *@
    <div id="step2" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 mb-4 hidden">
        <div class="p-5">
            <h2 class="font-semibold text-gray-800 mb-4">Paso 2 — Confirma la reprogramación</h2>

            <table class="w-full text-sm mb-4">
                <tbody class="divide-y divide-gray-100">
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2 w-2/5">Médico</th>
                        <td class="font-semibold text-gray-800 py-2">@Model.DoctorName</td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Fecha y hora anterior</th>
                        <td class="line-through text-gray-400 py-2">@Model.CurrentAppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Nueva fecha y hora</th>
                        <td id="confirmDateTime" class="font-semibold text-blue-600 py-2"></td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Nuevo estado</th>
                        <td class="py-2"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">Pendiente</span></td>
                    </tr>
                </tbody>
            </table>

            <div class="flex items-start gap-2 bg-sky-50 border border-sky-300 text-sky-800 px-4 py-3 rounded-lg mt-2">
                <i class="fas fa-circle-info mt-1"></i>
                <span>
                    Al reprogramar, la cita volverá a estado <strong>Pendiente</strong> hasta que el médico
                    la confirme nuevamente. Se enviará un correo con los nuevos datos al médico y a ti.
                </span>
            </div>

            <div class="mt-5 flex justify-between">
                <button id="btnStep2Back" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">
                    <i class="fas fa-arrow-left"></i> Atrás
                </button>
                <button id="btnConfirm" class="inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2 px-5 rounded-lg transition">
                    <i class="fas fa-check-circle"></i> Confirmar reprogramación
                </button>
            </div>
        </div>
    </div>

    @* ═══ PASO 3: Éxito ═══ *@
    <div id="step3" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 hidden">
        <div class="p-8 text-center">
            <div class="mb-3">
                <i class="fas fa-circle-check text-green-500 text-5xl"></i>
            </div>
            <h2 class="font-bold text-lg text-gray-800">¡Cita reprogramada con éxito!</h2>
            <p class="text-gray-500 mt-1">Tu cita quedó <strong>Pendiente</strong> de confirmación por el médico.</p>
            <p class="text-gray-400 text-sm mt-1">Recibirás un correo con los nuevos datos en breve.</p>
            <a asp-controller="PatientAppointments" asp-action="Index"
               class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition mt-4">
                Ver mis citas
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .step-circle {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            background: #e5e7eb;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .85rem;
            transition: background .3s;
        }

        .step-item.active .step-circle {
            background: #2563eb;
            color: #fff;
        }

        .step-item.done .step-circle {
            background: #16a34a;
            color: #fff;
        }

        .step-label {
            font-size: .78rem;
            color: #6b7280;
        }

        .step-line {
            height: 2px;
            background: #e5e7eb;
        }

        .slot-btn {
            min-width: 90px;
        }

            .slot-btn.selected {
                background: #2563eb;
                color: #fff;
                border-color: #2563eb;
            }
    </style>
}

@section Scripts {
    <script>
        const state = {
            appointmentId:   @Model.AppointmentId,
            doctorId:        @Model.DoctorId,
            doctorName: '@Model.DoctorName',
            appointmentDate: null,
            selectedTime: null
        };

        const API = 'https://localhost:7098/api';

        const alertStyles = {
            danger: 'bg-red-50 border-red-300 text-red-800',
            warning: 'bg-yellow-50 border-yellow-300 text-yellow-800',
            success: 'bg-green-50 border-green-300 text-green-800',
            info: 'bg-sky-50 border-sky-300 text-sky-800'
        };

        function showAlert(msg, type = 'danger') {
            const styles = alertStyles[type] || alertStyles.danger;
            document.getElementById('alertContainer').innerHTML =
                `<div class="flex items-center gap-3 border px-4 py-3 rounded-lg ${styles}">${msg}</div>`;
        }

        function clearAlert() {
            document.getElementById('alertContainer').innerHTML = '';
        }

        function goToStep(n) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
            document.getElementById(`step${n}`).classList.remove('hidden');

            for (let i = 1; i <= 2; i++) {
                const ind = document.getElementById(`step-indicator-${i}`);
                ind.classList.remove('active', 'done');
                if (i < n) ind.classList.add('done');
                else if (i === n) ind.classList.add('active');
            }
            clearAlert();
        }

        document.getElementById('appointmentDate').addEventListener('change', async function() {
            state.appointmentDate = this.value;
            state.selectedTime = null;
            document.getElementById('btnStep1Next').disabled = true;

            const container = document.getElementById('slotsContainer');
            container.innerHTML = '<p class="text-gray-500 text-sm">Cargando horarios...</p>';

            try {
                const res = await fetch(
                    `${API}/appointments/availability?doctorId=${state.doctorId}&date=${this.value}`);
                const data = await res.json().catch(() => null);

                if (!res.ok) {
                    throw new Error((data && data.mensaje) || `Error del servidor (${res.status})`);
                }

                const slots = (data && data.datos) || [];

                if (!slots.length) {
                    container.innerHTML =
                        '<div class="flex items-center gap-3 bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg">El médico no tiene disponibilidad en esta fecha.</div>';
                    return;
                }

                container.innerHTML = `
                            <p class="font-semibold text-gray-700 mb-2 text-sm">Horarios disponibles:</p>
                            <div class="flex flex-wrap gap-2">
                                ${slots.map(s => `
                                    <button type="button"
                                            class="slot-btn border border-blue-600 text-blue-600 hover:bg-blue-50 text-sm font-semibold py-1.5 px-3 rounded-lg transition"
                                            onclick="selectSlot('${s.startTime}', this)">
                                        ${s.startTime}
                                    </button>`).join('')}
                            </div>`;
            } catch (err) {
                console.error('Error al cargar horarios:', err);
                const detail = err && err.message ? err.message : 'No se pudo conectar con el servidor.';
                container.innerHTML =
                    `<div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg">Error al cargar horarios: ${detail}</div>`;
            }
        });

        function selectSlot(time, btn) {
            state.selectedTime = time;
            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            document.getElementById('btnStep1Next').disabled = false;
        }

        document.getElementById('btnStep1Next').addEventListener('click', () => {
            const dt = new Date(`${state.appointmentDate}T${state.selectedTime}`);
            document.getElementById('confirmDateTime').textContent =
                dt.toLocaleDateString('es-DO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) +
                ' a las ' + state.selectedTime;
            goToStep(2);
        });

        document.getElementById('btnStep2Back').addEventListener('click', () => goToStep(1));

        document.getElementById('btnConfirm').addEventListener('click', async () => {
            const btn = document.getElementById('btnConfirm');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verificando...';

            const newAppointmentDate = `${state.appointmentDate}T${state.selectedTime}:00`;

            try {
                const checkRes = await fetch(
                    `${API}/appointments/check-slot?doctorId=${state.doctorId}&appointmentDate=${newAppointmentDate}`);
                const checkData = await checkRes.json();

                if (!checkData.disponible) {
                    showAlert(checkData.mensaje);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar reprogramación';
                    return;
                }

                const payload = {
                    appointmentId: state.appointmentId,
                    newAppointmentDate: newAppointmentDate
                };

                const res = await fetch(`${API}/appointments/${state.appointmentId}/reschedule`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.exitoso) {
                    goToStep(3);
                } else {
                    showAlert(data.mensaje || 'No se pudo reprogramar la cita. Selecciona otro horario.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar reprogramación';
                }
            } catch {
                showAlert('Error de conexión. Por favor intenta de nuevo.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar reprogramación';
            }
        });
    </script>
}