@model SGMC.Web.Models.Appointment.RescheduleAppointmentViewModel
@{
    ViewData["Title"] = "Reprogramar Cita";
}

<div class="container py-4">
    <h2 class="mb-1 fw-bold text-primary">
        <i class="bi bi-calendar-event me-2"></i>Reprogramar Cita
    </h2>
    <p class="text-muted mb-4">Selecciona una nueva fecha y hora disponible con el mismo médico.</p>

    {{-- Resumen de la cita actual --}}
    <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="fw-semibold">@Model.DoctorName</div>
            <div class="text-muted small">
                Cita actual:
                @Model.CurrentAppointmentDate.ToString("dddd d 'de' MMMM, HH:mm", new System.Globalization.CultureInfo("es-DO"))
                — <span class="badge bg-warning text-dark">@Model.CurrentStatusName</span>
            </div>
        </div>
    </div>

    {{-- Barra de progreso (2 pasos, el médico ya está fijo) --}}
    <div class="d-flex align-items-center mb-4 gap-2">
        <div class="step-item active" id="step-indicator-1">
            <span class="step-circle">1</span>
            <span class="step-label d-none d-md-inline">Nueva fecha y hora</span>
        </div>
        <div class="step-line flex-grow-1"></div>
        <div class="step-item" id="step-indicator-2">
            <span class="step-circle">2</span>
            <span class="step-label d-none d-md-inline">Confirmar</span>
        </div>
    </div>

    <div id="alertContainer"></div>

    {{-- ═══ PASO 1: Seleccionar nueva fecha y hora ═══ --}}
    <div id="step1" class="wizard-step card shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <h5 class="card-title mb-3">Paso 1 — Selecciona la nueva fecha y hora</h5>

            <div class="mb-3">
                <label for="appointmentDate" class="form-label fw-semibold">Fecha</label>
                <input type="date" id="appointmentDate" class="form-control"
                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>

            <div id="slotsContainer" class="mt-3">
                <p class="text-muted">Selecciona una fecha para ver los horarios disponibles del médico.</p>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-controller="PatientAppointments" asp-action="Details" asp-route-id="@Model.AppointmentId"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Cancelar
                </a>
                <button id="btnStep1Next" class="btn btn-primary" disabled>
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>

    {{-- ═══ PASO 2: Confirmar reprogramación ═══ --}}
    <div id="step2" class="wizard-step card shadow-sm border-0 mb-3 d-none">
        <div class="card-body p-4">
            <h5 class="card-title mb-3">Paso 2 — Confirma la reprogramación</h5>

            <div class="table-responsive">
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th class="text-muted" style="width:40%">Médico</th>
                            <td class="fw-semibold">@Model.DoctorName</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Fecha y hora anterior</th>
                            <td class="text-decoration-line-through text-muted">
                                @Model.CurrentAppointmentDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Nueva fecha y hora</th>
                            <td id="confirmDateTime" class="fw-semibold text-primary"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Nuevo estado</th>
                            <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="alert alert-info d-flex align-items-start gap-2 mt-2">
                <i class="bi bi-info-circle-fill mt-1"></i>
                <span>
                    Al reprogramar, la cita volverá a estado <strong>Pendiente</strong> hasta que el médico
                    la confirme nuevamente. Se enviará un correo con los nuevos datos al médico y a ti.
                </span>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <button id="btnStep2Back" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Atrás
                </button>
                <button id="btnConfirm" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Confirmar reprogramación
                </button>
            </div>
        </div>
    </div>

    {{-- ═══ PASO 3: Éxito ═══ --}}
    <div id="step3" class="wizard-step card shadow-sm border-0 d-none">
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
            </div>
            <h5 class="fw-bold">¡Cita reprogramada con éxito!</h5>
            <p class="text-muted">Tu cita quedó <strong>Pendiente</strong> de confirmación por el médico.</p>
            <p class="text-muted small">Recibirás un correo con los nuevos datos en breve.</p>
            <a asp-controller="PatientAppointments" asp-action="Index" class="btn btn-primary mt-2">
                Ver mis citas
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .step-item {
            display: flex;
            align-items: center;
            gap: .4rem;
            flex-direction: column;
        }

        .step-circle {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            background: #dee2e6;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .85rem;
            transition: background .3s;
        }

        .step-item.active .step-circle {
            background: #0d6efd;
            color: #fff;
        }

        .step-item.done .step-circle {
            background: #198754;
            color: #fff;
        }

        .step-label {
            font-size: .78rem;
            color: #6c757d;
        }

        .step-line {
            height: 2px;
            background: #dee2e6;
        }

        .slot-btn {
            min-width: 90px;
        }

            .slot-btn.selected {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }
    </style>
}

@section Scripts {
    <script>
        const state = {
            appointmentId:   @Model.AppointmentId,
            doctorId:        @Model.DoctorId,
            doctorName:      '@Model.DoctorName',
            appointmentDate: null,
            selectedTime:    null
        };

        const API = 'https://localhost:7038/api';

        function showAlert(msg, type = 'danger') {
            document.getElementById('alertContainer').innerHTML =
                `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                 </div>`;
        }

        function clearAlert() {
            document.getElementById('alertContainer').innerHTML = '';
        }

        function goToStep(n) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('d-none'));
            document.getElementById(`step${n}`).classList.remove('d-none');

            for (let i = 1; i <= 2; i++) {
                const ind = document.getElementById(`step-indicator-${i}`);
                ind.classList.remove('active', 'done');
                if (i < n) ind.classList.add('done');
                else if (i === n) ind.classList.add('active');
            }
            clearAlert();
        }

        // ── Paso 1: cargar horarios disponibles del MISMO médico ─────────────────
        document.getElementById('appointmentDate').addEventListener('change', async function () {
            state.appointmentDate = this.value;
            state.selectedTime    = null;
            document.getElementById('btnStep1Next').disabled = true;

            const container = document.getElementById('slotsContainer');
            container.innerHTML = '<p class="text-muted">Cargando horarios...</p>';

            try {
                const res  = await fetch(
                    `${API}/appointments/availability?doctorId=${state.doctorId}&date=${this.value}`);
                const data = await res.json();
                const slots = data.datos || [];

                if (!slots.length) {
                    container.innerHTML =
                        '<div class="alert alert-warning">El médico no tiene disponibilidad en esta fecha.</div>';
                    return;
                }

                container.innerHTML = `
                    <p class="fw-semibold mb-2">Horarios disponibles:</p>
                    <div class="d-flex flex-wrap gap-2">
                        ${slots.map(s => `
                            <button type="button"
                                    class="btn btn-outline-primary slot-btn"
                                    onclick="selectSlot('${s.startTime}', this)">
                                ${s.startTime}
                            </button>`).join('')}
                    </div>`;
            } catch {
                container.innerHTML = '<div class="alert alert-danger">Error al cargar horarios.</div>';
            }
        });

        function selectSlot(time, btn) {
            state.selectedTime = time;
            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            document.getElementById('btnStep1Next').disabled = false;
        }

        document.getElementById('btnStep1Next').addEventListener('click', () => {
            const dt = new Date(`${state.appointmentDate}T${state.selectedTime}`);
            document.getElementById('confirmDateTime').textContent =
                dt.toLocaleDateString('es-DO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) +
                ' a las ' + state.selectedTime;
            goToStep(2);
        });

        document.getElementById('btnStep2Back').addEventListener('click', () => goToStep(1));

        // ── Paso 2: verificación en tiempo real + confirmar reprogramación ────────
        document.getElementById('btnConfirm').addEventListener('click', async () => {
            const btn = document.getElementById('btnConfirm');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verificando...';

            const newAppointmentDate = `${state.appointmentDate}T${state.selectedTime}:00`;

            try {
                // Verificación en tiempo real antes de confirmar (mismo endpoint de Task 132)
                const checkRes = await fetch(
                    `${API}/appointments/check-slot?doctorId=${state.doctorId}&appointmentDate=${newAppointmentDate}`);
                const checkData = await checkRes.json();

                if (!checkData.disponible) {
                    showAlert(checkData.mensaje);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirmar reprogramación';
                    return;
                }

                // Task 140: PUT transaccional de reprogramación
                const payload = {
                    appointmentId:      state.appointmentId,
                    newAppointmentDate: newAppointmentDate
                };

                const res = await fetch(`${API}/appointments/${state.appointmentId}/reschedule`, {
                    method:  'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.exitoso) {
                    goToStep(3);
                } else {
                    showAlert(data.mensaje || 'No se pudo reprogramar la cita. Selecciona otro horario.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirmar reprogramación';
                }
            } catch {
                showAlert('Error de conexión. Por favor intenta de nuevo.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirmar reprogramación';
            }
        });
    </script>
}