@model SGMC.Web.Models.Appointment.DoctorPendingAppointmentsViewModel
@{
    ViewData["Title"] = "Solicitudes Pendientes";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <div class="flex items-center gap-3 mb-6">
        <div class="bg-yellow-100 rounded-full p-3">
            <i class="fas fa-clock text-yellow-600 text-2xl"></i>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Solicitudes de Citas Pendientes</h1>
            <p class="text-gray-500 text-sm">Confirma o rechaza las solicitudes de tus pacientes.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-300 text-green-800 px-4 py-3 rounded-lg mb-5">
            <i class="fas fa-check-circle text-green-500 text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-5">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    {{-- Selector de médico (temporal, mientras no exista login de médico) --}}
    <form method="get" asp-action="Pending" class="mb-6">
        <label for="doctorId" class="block text-sm font-semibold text-gray-700 mb-1">Selecciona tu perfil de médico</label>
        <select id="doctorId" name="doctorId" class="form-select w-full sm:w-96 rounded-lg border-gray-300"
                onchange="this.form.submit()">
            <option value="">-- Selecciona un médico --</option>
            @foreach (var doctor in Model.Doctors)
            {
                <option value="@doctor.DoctorId" selected="@(doctor.DoctorId == Model.SelectedDoctorId)">
                    @doctor.FullName — @doctor.SpecialtyName
                </option>
            }
        </select>
    </form>

    @if (!Model.SelectedDoctorId.HasValue)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center">
            <i class="fas fa-user-md text-gray-300 text-4xl mb-3"></i>
            <p class="text-gray-500">Selecciona un médico para ver sus solicitudes pendientes.</p>
        </div>
    }
    else if (!Model.PendingAppointments.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center">
            <i class="fas fa-check-circle text-green-300 text-4xl mb-3"></i>
            <p class="text-gray-500">No hay solicitudes pendientes en este momento.</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var appt in Model.PendingAppointments)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="bg-blue-50 rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-user text-blue-600"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800">@appt.PatientName</p>
                            <p class="text-sm text-gray-500">
                                <i class="fas fa-calendar-day text-gray-300 mr-1"></i>
                                @appt.AppointmentDate.ToString("dddd d 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-DO"))
                                a las @appt.AppointmentDate.ToString("HH:mm")
                            </p>
                            <p class="text-xs text-gray-400 mt-0.5">
                                Solicitada el @appt.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-2 flex-shrink-0">
                        <form method="post" asp-action="Confirm" onsubmit="return confirm('¿Confirmar esta cita?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                            <input type="hidden" name="doctorId" value="@Model.SelectedDoctorId" />
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
                                <i class="fas fa-check"></i> Confirmar
                            </button>
                        </form>

                        <form method="post" asp-action="Reject" onsubmit="return confirm('¿Rechazar esta solicitud? El paciente deberá elegir otra fecha.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                            <input type="hidden" name="doctorId" value="@Model.SelectedDoctorId" />
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
                                <i class="fas fa-times"></i> Rechazar
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>