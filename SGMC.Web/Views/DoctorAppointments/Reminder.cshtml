@model SGMC.Web.Models.Appointment.ScheduleReminderViewModel
@{
    ViewData["Title"] = "Programar recordatorio";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <a asp-controller="DoctorAppointments" asp-action="Details" asp-route-id="@Model.AppointmentId"
       class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 mb-5 transition">
        <i class="fas fa-arrow-left"></i> Volver al detalle de la cita
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
            @TempData["Error"]
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-amber-400 px-6 py-5 text-white">
            <p class="text-white/70 text-xs uppercase tracking-wide mb-1">Cita #@Model.AppointmentId</p>
            <h2 class="text-xl font-bold"><i class="fas fa-bell mr-1"></i> Programar recordatorio</h2>
            <p class="text-white/80 text-sm mt-0.5">Para @Model.PatientName</p>
        </div>

        <form asp-controller="DoctorAppointments" asp-action="Reminder" method="post" class="p-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AppointmentId" />

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Plantilla predefinida</label>
                <select asp-for="SelectedTemplateId" class="w-full rounded-lg border-gray-300 text-sm">
                    <option value="">— Redactar mensaje personalizado —</option>
                    @foreach (var t in Model.Templates)
                    {
                        <option value="@t.TemplateId">@t.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Mensaje personalizado</label>
                <textarea asp-for="CustomMessage" rows="4"
                          placeholder="Escribe aquí tu mensaje si no vas a usar una plantilla..."
                          class="w-full rounded-lg border-gray-300 text-sm"></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Fecha y hora de envío</label>
                <input asp-for="ScheduledAt" type="datetime-local"
                       class="w-full rounded-lg border-gray-300 text-sm" />
                <span asp-validation-for="ScheduledAt" class="text-xs text-red-600"></span>
            </div>

            <div class="flex justify-end">
                <button type="submit"
                        class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold py-2.5 px-5 rounded-lg transition shadow-sm">
                    <i class="fas fa-paper-plane"></i> Programar recordatorio
                </button>
            </div>
        </form>
    </div>

    @if (Model.ExistingReminders.Any())
    {
        <div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-3 bg-gray-50 border-b border-gray-100">
                <h3 class="text-sm font-semibold text-gray-700"><i class="fas fa-history mr-1"></i> Historial de recordatorios de esta cita</h3>
            </div>
            <div class="divide-y divide-gray-100">
                @foreach (var r in Model.ExistingReminders)
                {
                    var statusClass = r.Status switch
                    {
                        "Enviado" => "bg-green-100 text-green-800",
                        "Cancelado" => "bg-red-100 text-red-800",
                        _ => "bg-yellow-100 text-yellow-800"
                    };
                    <div class="px-6 py-4">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-semibold px-2 py-0.5 rounded-full @statusClass">@r.Status</span>
                            <span class="text-xs text-gray-400">Programado: @r.ScheduledAt.ToString("dd/MM/yyyy hh:mm tt")</span>
                        </div>
                        <p class="text-sm text-gray-700">@r.Message</p>
                        @if (r.SentAt.HasValue)
                        {
                            <p class="text-xs text-gray-400 mt-1">Enviado: @r.SentAt.Value.ToString("dd/MM/yyyy hh:mm tt")</p>
                        }
                        @if (r.CancelledAt.HasValue)
                        {
                            <p class="text-xs text-gray-400 mt-1">Cancelado: @r.CancelledAt.Value.ToString("dd/MM/yyyy hh:mm tt")</p>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
