@model SGMC.Application.Dto.Insurance.InsuranceProviderDto

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Botón volver -->
    <div class="mb-6">
        <a asp-action="Index"
           class="inline-flex items-center gap-2 text-sm text-teal-600 hover:text-teal-800 font-medium transition-colors">
            <i class="fas fa-arrow-left text-xs"></i>
            Volver al listado
        </a>
    </div>

    @* TASK 128: Esta vista solo es alcanzable si el proveedor es activo
       (el controller valida IsActive antes de llegar aquí). *@

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border @(Model.IsPreferred ? "border-yellow-300" : "border-gray-100")">

        <!-- Header -->
        <div class="@(Model.IsPreferred ? "bg-gradient-to-r from-yellow-50 to-amber-50" : "bg-gradient-to-r from-teal-50 to-cyan-50") px-6 pt-6 pb-5 border-b @(Model.IsPreferred ? "border-yellow-200" : "border-gray-100")">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="@Model.Name"
                             class="w-16 h-16 rounded-xl object-contain border @(Model.IsPreferred ? "border-yellow-200" : "border-teal-100") bg-white p-1 shadow-sm"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                        <div class="w-16 h-16 rounded-xl @(Model.IsPreferred ? "bg-yellow-100" : "bg-teal-100") items-center justify-center shadow-sm hidden">
                            <i class="fas fa-shield-alt @(Model.IsPreferred ? "text-yellow-600" : "text-teal-600") text-2xl"></i>
                        </div>
                    }
                    else
                    {
                        <div class="w-16 h-16 rounded-xl @(Model.IsPreferred ? "bg-yellow-100" : "bg-teal-100") flex items-center justify-center shadow-sm">
                            <i class="fas fa-shield-alt @(Model.IsPreferred ? "text-yellow-600" : "text-teal-600") text-2xl"></i>
                        </div>
                    }

                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">@Model.Name</h1>
                        <div class="flex flex-wrap items-center gap-2 mt-2">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.IsPreferred ? "bg-yellow-200 text-yellow-800" : "bg-teal-100 text-teal-700")">
                                <i class="fas fa-network-wired mr-1 text-[10px]"></i>
                                Red @Model.NetworkTypeName
                            </span>
                            @if (Model.IsPreferred)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-400 text-yellow-900">
                                    <i class="fas fa-star mr-1 text-yellow-800 text-[10px]"></i>
                                    Preferencial
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <span class="flex-shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5 animate-pulse"></span>
                    Disponible
                </span>
            </div>
        </div>

        <!-- Datos de contacto (visibles en detalle) -->
        <div class="divide-y divide-gray-100">

            <!-- Teléfono -->
            <div class="px-6 py-4 flex items-center gap-4">
                <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-phone-alt text-teal-500 text-sm"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Teléfono</p>
                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                        <a href="tel:@Model.PhoneNumber" class="hover:text-teal-600 transition-colors">
                            @Model.PhoneNumber
                        </a>
                    </p>
                </div>
            </div>

            <!-- Correo -->
            <div class="px-6 py-4 flex items-center gap-4">
                <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-envelope text-teal-500 text-sm"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Correo Electrónico</p>
                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                        <a href="mailto:@Model.Email" class="hover:text-teal-600 transition-colors">
                            @Model.Email
                        </a>
                    </p>
                </div>
            </div>

            <!-- Sitio Web -->
            @if (!string.IsNullOrEmpty(Model.Website))
            {
                <div class="px-6 py-4 flex items-center gap-4">
                    <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-globe text-teal-500 text-sm"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Sitio Web</p>
                        <p class="text-sm font-semibold mt-0.5">
                            <a href="@Model.Website" target="_blank" rel="noopener"
                               class="text-teal-600 hover:text-teal-800 hover:underline transition-colors inline-flex items-center gap-1">
                                @Model.Website
                                <i class="fas fa-external-link-alt text-[10px]"></i>
                            </a>
                        </p>
                    </div>
                </div>
            }

            <!-- Detalles de Cobertura -->
            @if (!string.IsNullOrEmpty(Model.CoverageDetails))
            {
                <div class="px-6 py-4 flex items-start gap-4">
                    <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-file-medical-alt text-teal-500 text-sm"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Detalles de Cobertura</p>
                        <p class="text-sm text-gray-700 mt-1 leading-relaxed">@Model.CoverageDetails</p>
                    </div>
                </div>
            }

            <!-- Monto máximo -->
            @if (Model.MaxCoverageAmount.HasValue)
            {
                <div class="px-6 py-4 flex items-center gap-4">
                    <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-dollar-sign text-teal-500 text-sm"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Monto Máximo de Cobertura</p>
                        <p class="text-sm font-semibold text-gray-800 mt-0.5">$@Model.MaxCoverageAmount.Value.ToString("N2")</p>
                    </div>
                </div>
            }

            <!-- Tipo de red -->
            <div class="px-6 py-4 flex items-center gap-4">
                <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-network-wired text-teal-500 text-sm"></i>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-medium">Tipo de Red</p>
                    <p class="text-sm font-semibold text-gray-800 mt-0.5">@Model.NetworkTypeName</p>
                </div>
            </div>

        </div>

        <!-- Pie -->
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
            <p class="text-xs text-gray-400">
                <i class="fas fa-lock mr-1 text-green-400"></i>
                Solo proveedores activos son visibles para pacientes
            </p>
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-lg transition duration-200 shadow-sm">
                <i class="fas fa-arrow-left text-xs"></i>
                Volver
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}