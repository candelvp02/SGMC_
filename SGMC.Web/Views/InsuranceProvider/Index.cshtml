@model IEnumerable<SGMC.Application.Dto.Insurance.InsuranceProviderDto>

@{
    ViewData["Title"] = "Proveedores de Seguro";
    var preferredList = Model.Where(p => p.IsPreferred).ToList();
    var regularList = Model.Where(p => !p.IsPreferred).ToList();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Encabezado -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center shadow-md">
                <i class="fas fa-shield-alt text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900">Proveedores de Seguro</h1>
        </div>
        <p class="text-gray-500 mt-1">Consulta los proveedores de seguro médico disponibles para tu cobertura</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-lg shadow-sm flex items-center gap-2">
            <i class="fas fa-exclamation-circle text-red-500"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="mb-6 bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-lg shadow-sm flex items-center gap-2">
            <i class="fas fa-exclamation-circle text-red-500"></i>
            <span>@ViewBag.ErrorMessage</span>
        </div>
    }

    @* TASK 128: El controlador solo llega aquí con proveedores activos.
       Si la lista está vacía, se muestra un mensaje claro al paciente. *@
    @if (!Model.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 py-20 text-center">
            <div class="w-16 h-16 bg-teal-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-shield-alt text-3xl text-teal-400"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-700 mb-2">Sin proveedores disponibles</h3>
            <p class="text-gray-400 text-sm">Por el momento no hay proveedores de seguro activos en el sistema.</p>
            <p class="text-gray-400 text-sm mt-1">Contacta a tu administrador para más información.</p>
        </div>
    }
    else
    {
        <!-- Contador -->
        <div class="mb-6">
            <p class="text-sm text-gray-500">
                <span class="font-semibold text-gray-700">@Model.Count()</span> proveedor@(Model.Count() != 1 ? "es" : "") disponible@(Model.Count() != 1 ? "s" : "")
                @if (preferredList.Any())
                {
                    <span class="ml-2 text-yellow-600 font-medium">
                        — <i class="fas fa-star text-yellow-400"></i> @preferredList.Count() preferencial@(preferredList.Count() != 1 ? "es" : "")
                    </span>
                }
            </p>
        </div>

        @* ── TASK 127: Sección de preferenciales ── *@
        @if (preferredList.Any())
        {
            <div class="mb-8">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-star text-yellow-400"></i>
                    <h2 class="text-lg font-bold text-gray-800">Proveedores Preferenciales</h2>
                    <span class="text-xs bg-yellow-100 text-yellow-700 font-semibold px-2 py-0.5 rounded-full">Recomendados</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    @foreach (var provider in preferredList)
                    {
                        <a asp-action="Details" asp-route-id="@provider.InsuranceProviderId"
                           class="group block bg-white rounded-2xl shadow-md border-2 border-yellow-300 hover:border-yellow-400 hover:shadow-xl transition-all duration-200 overflow-hidden relative">

                            <!-- Insignia preferencial -->
                            <div class="absolute top-3 right-3 z-10">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-400 text-yellow-900 shadow-sm">
                                    <i class="fas fa-star text-yellow-800 text-[10px]"></i>
                                    Preferencial
                                </span>
                            </div>

                            <!-- Header -->
                            <div class="bg-gradient-to-r from-yellow-50 to-amber-50 px-5 pt-5 pb-4 border-b border-yellow-100">
                                <div class="flex items-center gap-3 pr-20">
                                    @if (!string.IsNullOrEmpty(provider.LogoUrl))
                                    {
                                        <img src="@provider.LogoUrl" alt="@provider.Name"
                                             class="w-12 h-12 rounded-xl object-contain border border-yellow-200 bg-white p-1"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                                        <div class="w-12 h-12 rounded-xl bg-yellow-100 items-center justify-center hidden">
                                            <i class="fas fa-shield-alt text-yellow-600 text-lg"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center">
                                            <i class="fas fa-shield-alt text-yellow-600 text-lg"></i>
                                        </div>
                                    }
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-base group-hover:text-yellow-700 transition-colors line-clamp-1">
                                            @provider.Name
                                        </h3>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-200 text-yellow-800 mt-0.5">
                                            @provider.NetworkTypeName
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Cuerpo -->
                            <div class="px-5 py-4">
                                @if (!string.IsNullOrEmpty(provider.CoverageDetails))
                                {
                                    <p class="text-sm text-gray-600 line-clamp-2 mb-3">@provider.CoverageDetails</p>
                                }
                                <div class="flex items-center justify-between mt-2">
                                    <span class="text-xs text-gray-400">Ver información completa</span>
                                    <i class="fas fa-arrow-right text-yellow-500 text-xs group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }

        @* ── Otros proveedores ── *@
        @if (regularList.Any())
        {
            <div>
                @if (preferredList.Any())
                {
                    <div class="flex items-center gap-2 mb-4">
                        <i class="fas fa-building text-teal-500"></i>
                        <h2 class="text-lg font-bold text-gray-800">Otros Proveedores</h2>
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    @foreach (var provider in regularList)
                    {
                        <a asp-action="Details" asp-route-id="@provider.InsuranceProviderId"
                           class="group block bg-white rounded-2xl shadow-sm border border-gray-200 hover:border-teal-400 hover:shadow-lg transition-all duration-200 overflow-hidden">

                            <div class="bg-gradient-to-r from-teal-50 to-cyan-50 px-5 pt-5 pb-4 border-b border-gray-100">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(provider.LogoUrl))
                                    {
                                        <img src="@provider.LogoUrl" alt="@provider.Name"
                                             class="w-12 h-12 rounded-xl object-contain border border-teal-100 bg-white p-1"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                                        <div class="w-12 h-12 rounded-xl bg-teal-100 items-center justify-center hidden">
                                            <i class="fas fa-shield-alt text-teal-600 text-lg"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center">
                                            <i class="fas fa-shield-alt text-teal-600 text-lg"></i>
                                        </div>
                                    }
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-base group-hover:text-teal-700 transition-colors line-clamp-1">
                                            @provider.Name
                                        </h3>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-700 mt-0.5">
                                            @provider.NetworkTypeName
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="px-5 py-4">
                                @if (!string.IsNullOrEmpty(provider.CoverageDetails))
                                {
                                    <p class="text-sm text-gray-600 line-clamp-2 mb-3">@provider.CoverageDetails</p>
                                }
                                <div class="flex items-center justify-between mt-2">
                                    <span class="text-xs text-gray-400">Ver información completa</span>
                                    <i class="fas fa-arrow-right text-teal-400 text-xs group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}