@using SGMC.Application.Dto.System

@{
    ViewData["Title"] = "Detalles del Doctor";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <h1 class="text-2xl font-bold text-gray-800 mb-6">Detalles del Doctor</h1>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-5">
            <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
            <span>@ViewBag.ErrorMessage</span>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 mb-5">
        <dl class="text-sm divide-y divide-gray-100">
            <div class="flex justify-between py-2"><dt class="text-gray-500">ID</dt><dd class="text-gray-800">@Model.DoctorId</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Nombre Completo</dt><dd class="font-semibold text-gray-800">@Model.FullName</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Fecha de Nacimiento</dt><dd class="text-gray-800">@Model.DateOfBirth</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Cédula</dt><dd class="text-gray-800">@Model.IdentificationNumber</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Género</dt><dd class="text-gray-800">@(Model.Gender == "M" ? "Masculino" : "Femenino")</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Email</dt><dd class="text-gray-800">@Model.Email</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Teléfono</dt><dd class="text-gray-800">@Model.PhoneNumber</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Especialidad</dt><dd class="text-gray-800">@Model.SpecialtyName</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Número de Licencia</dt><dd class="text-gray-800">@Model.LicenseNumber</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Vencimiento de Licencia</dt><dd class="text-gray-800">@Model.LicenseExpirationDate</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Años de Experiencia</dt><dd class="text-gray-800">@Model.YearsOfExperience</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Educación</dt><dd class="text-gray-800">@Model.Education</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Biografía</dt><dd class="text-gray-800 text-right max-w-xs">@Model.Bio</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Tarifa de Consulta</dt><dd class="text-gray-800">@Model.ConsultationFee?.ToString("C")</dd></div>
            <div class="flex justify-between py-2"><dt class="text-gray-500">Dirección de Clínica</dt><dd class="text-gray-800 text-right max-w-xs">@Model.ClinicAddress</dd></div>
            <div class="flex justify-between items-center py-2">
                <dt class="text-gray-500">Estado</dt>
                <dd>
                    @if (Model.IsActive)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Activo</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">Inactivo</span>
                    }
                </dd>
            </div>
        </dl>
    </div>

    <div class="flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.DoctorId"
           class="inline-flex items-center gap-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">Editar</a>
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">Volver a la Lista</a>
    </div>
</div>
