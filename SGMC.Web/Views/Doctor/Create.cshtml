@model SGMC.Application.Dto.System.RegisterDoctorDto

@{
    ViewData["Title"] = "Registro de Médico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-3">
            <i class="fas fa-user-md text-blue-500"></i>
            Registro de Médico
        </h1>
        <p class="text-gray-500 mt-1">Complete todos los campos requeridos para registrarse en la plataforma.</p>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center gap-2">
            <i class="fas fa-exclamation-circle"></i>
            <span>@ViewBag.ErrorMessage</span>
        </div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6"></div>

        <!-- Sección 1: Información Personal -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2 border-b pb-2">
                <i class="fas fa-user text-blue-500"></i>
                Información Personal
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1">
                        Nombre <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="FirstName" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Ej: Juan" />
                    <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1">
                        Apellido <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="LastName" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Ej: Pérez" />
                    <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="DateOfBirth" class="block text-sm font-medium text-gray-700 mb-1">
                        Fecha de Nacimiento <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="DateOfBirth" type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    <span asp-validation-for="DateOfBirth" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="IdentificationNumber" class="block text-sm font-medium text-gray-700 mb-1">
                        Número de Identificación <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="IdentificationNumber" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="XXX-XXXXXXX-X" />
                    <span asp-validation-for="IdentificationNumber" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="Gender" class="block text-sm font-medium text-gray-700 mb-1">
                        Género <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="Gender" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">Seleccione...</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-red-500 text-xs mt-1"></span>
                </div>

            </div>
        </div>

        <!-- Sección 2: Información de Acceso -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2 border-b pb-2">
                <i class="fas fa-lock text-blue-500"></i>
                Información de Acceso
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">
                        Correo Electrónico <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="doctor@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">
                        Contraseña <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Password" type="password" id="passwordInput" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent pr-10" placeholder="Mínimo 8 caracteres" />
                        <button type="button" onclick="togglePassword()" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Mínimo 8 caracteres, una mayúscula y un número</p>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1">
                        Teléfono <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="PhoneNumber" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="XXX-XXX-XXXX" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs mt-1"></span>
                </div>

            </div>
        </div>

        <!-- Sección 3: Información Profesional -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2 border-b pb-2">
                <i class="fas fa-stethoscope text-blue-500"></i>
                Información Profesional
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label asp-for="SpecialtyId" class="block text-sm font-medium text-gray-700 mb-1">
                        Especialidad <span class="text-red-500">*</span>
                    </label>
                    @await Component.InvokeAsync("SpecialtySelect", new { selectedId = (short?)null, fieldName = "SpecialtyId" })
                    <span asp-validation-for="SpecialtyId" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="LicenseNumber" class="block text-sm font-medium text-gray-700 mb-1">
                        Número de Licencia Médica <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="LicenseNumber" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    <span asp-validation-for="LicenseNumber" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="LicenseExpirationDate" class="block text-sm font-medium text-gray-700 mb-1">
                        Fecha de Vencimiento de Licencia <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="LicenseExpirationDate" type="date" id="licenseExpDate" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    <p id="licenseExpError" class="text-red-500 text-xs mt-1 hidden">La fecha de vencimiento no puede ser una fecha pasada.</p>
                    <span asp-validation-for="LicenseExpirationDate" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="YearsOfExperience" class="block text-sm font-medium text-gray-700 mb-1">
                        Años de Experiencia <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="YearsOfExperience" type="number" min="0" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    <span asp-validation-for="YearsOfExperience" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Education" class="block text-sm font-medium text-gray-700 mb-1">
                        Educación / Formación Académica <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Education" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Describe tu formación académica..."></textarea>
                    <span asp-validation-for="Education" class="text-red-500 text-xs mt-1"></span>
                </div>

            </div>
        </div>

        <!-- Sección 4: Información Opcional -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2 border-b pb-2">
                <i class="fas fa-info-circle text-blue-500"></i>
                Información Adicional <span class="text-sm font-normal text-gray-400">(opcional)</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div class="md:col-span-2">
                    <label asp-for="Bio" class="block text-sm font-medium text-gray-700 mb-1">Biografía</label>
                    <textarea asp-for="Bio" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Cuéntanos sobre ti..."></textarea>
                </div>

                <div>
                    <label asp-for="ConsultationFee" class="block text-sm font-medium text-gray-700 mb-1">Tarifa de Consulta (RD$)</label>
                    <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="0.00" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Modalidad de Atención</label>
                    <select name="AvailabilityMode" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">Seleccione...</option>
                        <option value="Presencial">Presencial</option>
                        <option value="Virtual">Virtual</option>
                        <option value="Híbrido">Híbrido</option>
                    </select>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="ClinicAddress" class="block text-sm font-medium text-gray-700 mb-1">Dirección del Consultorio</label>
                    <textarea asp-for="ClinicAddress" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Dirección completa del consultorio..."></textarea>
                </div>

            </div>
        </div>

        <!-- Botones -->
        <div class="flex flex-col sm:flex-row gap-3 justify-end">
            <a asp-action="Index" class="flex items-center justify-center gap-2 px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 transition">
                <i class="fas fa-times"></i> Cancelar
            </a>
            <button type="submit" class="flex items-center justify-center gap-2 px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                <i class="fas fa-save"></i> Registrar Médico
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Mostrar/ocultar contraseña
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Validar fecha de vencimiento de licencia
        document.getElementById('licenseExpDate').addEventListener('change', function () {
            const today = new Date().toISOString().split('T')[0];
            const errorMsg = document.getElementById('licenseExpError');
            if (this.value < today) {
                errorMsg.classList.remove('hidden');
                this.classList.add('border-red-500');
            } else {
                errorMsg.classList.add('hidden');
                this.classList.remove('border-red-500');
            }
        });
    </script>
}