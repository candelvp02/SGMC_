@model SGMC.Application.Dto.Users.RegisterPatientDto

<fieldset class="border border-gray-300 rounded-lg p-4 mb-4">
    <legend class="px-2 text-sm font-semibold text-gray-600 flex items-center gap-1">
        <i class="fas fa-user"></i> Información Personal
    </legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-3">
        <div>
            <label asp-for="FirstName" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <input asp-for="FirstName" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Juan" />
            <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1"></span>
        </div>
        <div>
            <label asp-for="LastName" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <input asp-for="LastName" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Pérez" />
            <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1"></span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label asp-for="IdentificationNumber" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <input asp-for="IdentificationNumber" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   placeholder="XXX-XXXXXXX-X" />
            <span asp-validation-for="IdentificationNumber" class="text-red-500 text-xs mt-1"></span>
        </div>
        <div>
            <label asp-for="Gender" class="block text-sm font-semibold text-gray-700 mb-1"></label>
            <select asp-for="Gender" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">-- Seleccione --</option>
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
            </select>
            <span asp-validation-for="Gender" class="text-red-500 text-xs mt-1"></span>
        </div>
    </div>
</fieldset>
