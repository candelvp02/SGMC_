@{
    ViewData["Title"] = "Agendar Cita";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-2xl font-bold text-blue-600 mb-1 flex items-center gap-2">
        <i class="fas fa-calendar-plus"></i> Agendar Cita
    </h1>
    <p class="text-gray-500 mb-6">Sigue los pasos para reservar tu cita médica.</p>

    @* Barra de progreso del wizard *@
    <div class="flex items-center gap-2 mb-6">
        <div class="step-item active flex flex-col items-center gap-1" id="step-indicator-1">
            <span class="step-circle">1</span>
            <span class="step-label hidden md:inline">Médico</span>
        </div>
        <div class="step-line flex-grow"></div>
        <div class="step-item flex flex-col items-center gap-1" id="step-indicator-2">
            <span class="step-circle">2</span>
            <span class="step-label hidden md:inline">Fecha y hora</span>
        </div>
        <div class="step-line flex-grow"></div>
        <div class="step-item flex flex-col items-center gap-1" id="step-indicator-3">
            <span class="step-circle">3</span>
            <span class="step-label hidden md:inline">Confirmar</span>
        </div>
    </div>

    @* Alertas *@
    <div id="alertContainer" class="mb-4"></div>

    @* ═══ PASO 1: Seleccionar médico ═══ *@
    <div id="step1" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 mb-4">
        <div class="p-5">
            <h2 class="font-semibold text-gray-800 mb-4">Paso 1 — Selecciona un médico</h2>

            <div class="mb-4">
                <label for="specialtySelect" class="block text-sm font-semibold text-gray-700 mb-1">Especialidad</label>
                <select id="specialtySelect" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Todas las especialidades --</option>
                </select>
            </div>

            <div id="doctorListContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mt-1"></div>

            <div class="mt-5 flex justify-end">
                <button id="btnStep1Next" class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold py-2 px-4 rounded-lg transition" disabled>
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    @* ═══ PASO 2: Seleccionar fecha y hora ═══ *@
    <div id="step2" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 mb-4 hidden">
        <div class="p-5">
            <h2 class="font-semibold text-gray-800 mb-4">Paso 2 — Selecciona fecha y hora</h2>

            <div class="mb-4">
                <label for="appointmentDate" class="block text-sm font-semibold text-gray-700 mb-1">Fecha</label>
                <input type="date" id="appointmentDate"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>

            <div id="slotsContainer" class="mt-3">
                <p class="text-gray-500 text-sm">Selecciona una fecha para ver los horarios disponibles.</p>
            </div>

            <div class="mt-5 flex justify-between">
                <button id="btnStep2Back" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">
                    <i class="fas fa-arrow-left"></i> Atrás
                </button>
                <button id="btnStep2Next" class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold py-2 px-4 rounded-lg transition" disabled>
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    @* ═══ PASO 3: Confirmar cita ═══ *@
    <div id="step3" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 mb-4 hidden">
        <div class="p-5">
            <h2 class="font-semibold text-gray-800 mb-4">Paso 3 — Confirma tu cita</h2>

            <table class="w-full text-sm mb-4">
                <tbody class="divide-y divide-gray-100">
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2 w-2/5">Médico</th>
                        <td id="confirmDoctor" class="font-semibold text-gray-800 py-2"></td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Especialidad</th>
                        <td id="confirmSpecialty" class="text-gray-800 py-2"></td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Fecha y hora</th>
                        <td id="confirmDateTime" class="font-semibold text-blue-600 py-2"></td>
                    </tr>
                    <tr>
                        <th class="text-left text-gray-500 font-normal py-2">Estado inicial</th>
                        <td class="py-2"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">Pendiente</span></td>
                    </tr>
                </tbody>
            </table>

            <div class="flex items-start gap-2 bg-sky-50 border border-sky-300 text-sky-800 px-4 py-3 rounded-lg mt-2">
                <i class="fas fa-circle-info mt-1"></i>
                <span>
                    La cita quedará en estado <strong>Pendiente</strong> hasta que el médico la confirme.
                    Recibirás un correo de confirmación al agendar.
                </span>
            </div>

            <div class="mt-5 flex justify-between">
                <button id="btnStep3Back" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">
                    <i class="fas fa-arrow-left"></i> Atrás
                </button>
                <button id="btnConfirm" class="inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2 px-5 rounded-lg transition">
                    <i class="fas fa-check-circle"></i> Confirmar cita
                </button>
            </div>
        </div>
    </div>

    @* ═══ PASO 4: Éxito ═══ *@
    <div id="step4" class="wizard-step bg-white rounded-xl shadow-sm border border-gray-100 hidden">
        <div class="p-8 text-center">
            <div class="mb-3">
                <i class="fas fa-circle-check text-green-500 text-5xl"></i>
            </div>
            <h2 class="font-bold text-lg text-gray-800">¡Cita agendada con éxito!</h2>
            <p class="text-gray-500 mt-1">Tu solicitud fue recibida y está <strong>Pendiente</strong> de confirmación por el médico.</p>
            <p class="text-gray-400 text-sm mt-1">Recibirás un correo de confirmación en breve.</p>
            <a asp-controller="Appointments" asp-action="Index"
               class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition mt-4">
                Ver mis citas
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .step-circle {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            background: #e5e7eb;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .85rem;
            transition: background .3s;
        }

        .step-item.active .step-circle {
            background: #2563eb;
            color: #fff;
        }

        .step-item.done .step-circle {
            background: #16a34a;
            color: #fff;
        }

        .step-label {
            font-size: .78rem;
            color: #6b7280;
        }

        .step-line {
            height: 2px;
            background: #e5e7eb;
        }

        .slot-btn {
            min-width: 90px;
        }

            .slot-btn.selected {
                background: #2563eb;
                color: #fff;
                border-color: #2563eb;
            }

        .doctor-card {
            cursor: pointer;
            border: 2px solid transparent;
            transition: border .2s;
        }

            .doctor-card.selected {
                border-color: #2563eb;
                background: #eff6ff;
            }
    </style>
}

@section Scripts {
    <script>
        const state = {
            doctorId: null,
            doctorName: '',
            specialtyName: '',
            appointmentDate: null,
            selectedTime: null,
            patientId: 1
        };

        const API = 'https://localhost:7098/api';

        const alertStyles = {
            danger: 'bg-red-50 border-red-300 text-red-800',
            warning: 'bg-yellow-50 border-yellow-300 text-yellow-800',
            success: 'bg-green-50 border-green-300 text-green-800',
            info: 'bg-sky-50 border-sky-300 text-sky-800'
        };

        function showAlert(msg, type = 'danger') {
            const styles = alertStyles[type] || alertStyles.danger;
            document.getElementById('alertContainer').innerHTML =
                `<div class="flex items-center gap-3 border px-4 py-3 rounded-lg ${styles}">${msg}</div>`;
        }

        function clearAlert() {
            document.getElementById('alertContainer').innerHTML = '';
        }

        function goToStep(n) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
            document.getElementById(`step${n}`).classList.remove('hidden');

            for (let i = 1; i <= 3; i++) {
                const ind = document.getElementById(`step-indicator-${i}`);
                ind.classList.remove('active', 'done');
                if (i < n) ind.classList.add('done');
                else if (i === n) ind.classList.add('active');
            }
            clearAlert();
        }

        async function loadSpecialties() {
            try {
                const res = await fetch(`${API}/specialties`);
                const data = await res.json();
                const sel = document.getElementById('specialtySelect');
                (data.datos || []).forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.specialtyId;
                    opt.textContent = s.specialtyName;
                    sel.appendChild(opt);
                });
            } catch { /* silencioso */ }
        }

        async function loadDoctors(specialtyId = null) {
            try {
                const url = specialtyId
                    ? `${API}/doctors/specialty/${specialtyId}`
                    : `${API}/doctors`;
                const res = await fetch(url);
                const data = await res.json();
                renderDoctors(data.datos || []);
            } catch {
                document.getElementById('doctorListContainer').innerHTML =
                    '<p class="text-red-500 text-sm">Error al cargar médicos.</p>';
            }
        }

        function renderDoctors(doctors) {
            const container = document.getElementById('doctorListContainer');
            if (!doctors.length) {
                container.innerHTML = '<p class="text-gray-500 text-sm">No hay médicos disponibles.</p>';
                return;
            }
            container.innerHTML = doctors.map(d => `
                        <div class="doctor-card bg-white border border-gray-200 rounded-xl p-3"
                             onclick="selectDoctor(${d.doctorId}, '${d.fullName}', '${d.specialtyName}')">
                            <div class="flex items-center gap-3">
                                <div class="rounded-full bg-blue-600 text-white flex items-center justify-center"
                                     style="width:48px;height:48px;font-size:1.1rem">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <div class="font-semibold text-gray-800">${d.fullName}</div>
                                    <div class="text-gray-500 text-sm">${d.specialtyName}</div>
                                    <div class="text-gray-500 text-sm">
                                        <i class="fas fa-dollar-sign"></i> RD$${d.consultationFee?.toLocaleString() ?? '--'}
                                    </div>
                                </div>
                            </div>
                        </div>`).join('');
        }

        function selectDoctor(id, name, specialty) {
            state.doctorId = id;
            state.doctorName = name;
            state.specialtyName = specialty;

            document.querySelectorAll('.doctor-card').forEach(c => c.classList.remove('selected'));
            event.currentTarget.closest('.doctor-card').classList.add('selected');
            document.getElementById('btnStep1Next').disabled = false;
        }

        document.getElementById('specialtySelect').addEventListener('change', e =>
            loadDoctors(e.target.value || null));

        document.getElementById('btnStep1Next').addEventListener('click', () => goToStep(2));

        document.getElementById('appointmentDate').addEventListener('change', async function() {
            state.appointmentDate = this.value;
            state.selectedTime = null;
            document.getElementById('btnStep2Next').disabled = true;

            const container = document.getElementById('slotsContainer');
            container.innerHTML = '<p class="text-gray-500 text-sm">Cargando horarios...</p>';

            try {
                const res = await fetch(
                    `${API}/appointments/availability?doctorId=${state.doctorId}&date=${this.value}`);
                const data = await res.json();
                const slots = data.datos || [];

                if (!slots.length) {
                    container.innerHTML =
                        '<div class="flex items-center gap-3 bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg">El médico no tiene disponibilidad en esta fecha.</div>';
                    return;
                }

                container.innerHTML = `
                            <p class="font-semibold text-gray-700 mb-2 text-sm">Horarios disponibles:</p>
                            <div class="flex flex-wrap gap-2">
                                ${slots.map(s => `
                                    <button type="button"
                                            class="slot-btn border border-blue-600 text-blue-600 hover:bg-blue-50 text-sm font-semibold py-1.5 px-3 rounded-lg transition"
                                            onclick="selectSlot('${s.startTime}', this)">
                                        ${s.startTime}
                                    </button>`).join('')}
                            </div>`;
            } catch {
                container.innerHTML = '<div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg">Error al cargar horarios.</div>';
            }
        });

        function selectSlot(time, btn) {
            state.selectedTime = time;
            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            document.getElementById('btnStep2Next').disabled = false;
        }

        document.getElementById('btnStep2Back').addEventListener('click', () => goToStep(1));
        document.getElementById('btnStep2Next').addEventListener('click', () => {
            const dt = new Date(`${state.appointmentDate}T${state.selectedTime}`);
            document.getElementById('confirmDoctor').textContent = state.doctorName;
            document.getElementById('confirmSpecialty').textContent = state.specialtyName;
            document.getElementById('confirmDateTime').textContent =
                dt.toLocaleDateString('es-DO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) +
                ' a las ' + state.selectedTime;
            goToStep(3);
        });

        document.getElementById('btnStep3Back').addEventListener('click', () => goToStep(2));

        document.getElementById('btnConfirm').addEventListener('click', async () => {
            const btn = document.getElementById('btnConfirm');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verificando...';

            const appointmentDate = `${state.appointmentDate}T${state.selectedTime}:00`;

            try {
                const checkRes = await fetch(
                    `${API}/appointments/check-slot?doctorId=${state.doctorId}&appointmentDate=${appointmentDate}`);
                const checkData = await checkRes.json();

                if (!checkData.disponible) {
                    showAlert(checkData.mensaje);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar cita';
                    return;
                }

                const payload = {
                    patientId: state.patientId,
                    doctorId: state.doctorId,
                    appointmentDate: appointmentDate,
                    statusId: 1
                };

                const res = await fetch(`${API}/appointments`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.exitoso) {
                    goToStep(4);
                } else {
                    showAlert(data.mensaje || 'No se pudo agendar la cita.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar cita';
                }
            } catch {
                showAlert('Error de conexión. Por favor intenta de nuevo.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar cita';
            }
        });

        loadSpecialties();
        loadDoctors();
    </script>
}