@* SGMC.Web/Views/AppointmentAdm/Cancel.cshtml *@
@* Task 137 — Pantalla de confirmacion de cancelacion *@
@model SGMC.Web.Models.Appointment.AppointmentDetailsViewModel

@{
    ViewData["Title"] = "Cancelar Cita";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            @* Encabezado de advertencia *@
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <h4 class="mb-0">Confirmar Cancelacion de Cita</h4>
                    </div>
                </div>

                <div class="card-body">

                    @* Alerta visual de advertencia *@
                    <div class="alert alert-warning d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-circle-fill fs-5 mt-1 flex-shrink-0"></i>
                        <div>
                            <strong>Esta accion no se puede deshacer.</strong><br />
                            Al cancelar la cita, el medico sera notificado por correo electronico
                            y el horario quedara liberado automaticamente.
                        </div>
                    </div>

                    @* Resumen de la cita a cancelar *@
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-calendar-x"></i> Cita que sera cancelada
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">ID de la cita</dt>
                                <dd class="col-sm-8"><strong>#@Model.AppointmentId</strong></dd>

                                <dt class="col-sm-4 text-muted">Paciente</dt>
                                <dd class="col-sm-8">@Model.PatientName</dd>

                                <dt class="col-sm-4 text-muted">Doctor</dt>
                                <dd class="col-sm-8">Dr. @Model.DoctorName</dd>

                                <dt class="col-sm-4 text-muted">Fecha</dt>
                                <dd class="col-sm-8">
                                    <i class="bi bi-calendar"></i>
                                    @Model.AppointmentDateFormatted
                                </dd>

                                <dt class="col-sm-4 text-muted">Hora</dt>
                                <dd class="col-sm-8">
                                    <i class="bi bi-clock"></i>
                                    @Model.AppointmentTimeFormatted
                                </dd>

                                <dt class="col-sm-4 text-muted">Estado actual</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @Model.StatusBadgeClass">@Model.StatusName</span>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @* Consecuencias de la cancelacion *@
                    <div class="card mb-4 border-warning">
                        <div class="card-header bg-warning bg-opacity-25">
                            <h6 class="mb-0">
                                <i class="bi bi-info-circle"></i> Que ocurrira al confirmar
                            </h6>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-arrow-right-circle text-danger"></i>
                                El estado de la cita cambiara a <strong>Cancelada</strong>
                            </li>
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-arrow-right-circle text-danger"></i>
                                El horario del medico quedara <strong>liberado automaticamente</strong>
                            </li>
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-arrow-right-circle text-danger"></i>
                                Se enviara un correo de notificacion al <strong>medico y al paciente</strong>
                            </li>
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-arrow-right-circle text-danger"></i>
                                Se registrara la fecha y hora exacta de la cancelacion
                            </li>
                        </ul>
                    </div>

                    @* Botones de accion *@
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@Model.AppointmentId"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver sin cancelar
                        </a>

                        <form asp-action="CancelConfirmed" asp-route-id="@Model.AppointmentId"
                              method="post" id="cancelForm">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-danger px-4"
                                    onclick="confirmarCancelacion()">
                                <i class="bi bi-x-circle"></i> Si, cancelar esta cita
                            </button>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}

@section Scripts {
    <script>
        function confirmarCancelacion() {
            const btn = document.querySelector('#cancelForm button');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Cancelando...';
            document.getElementById('cancelForm').submit();
        }
    </script>
}