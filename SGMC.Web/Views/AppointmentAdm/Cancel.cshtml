@model SGMC.Web.Models.Appointment.AppointmentDetailsViewModel

@{
    ViewData["Title"] = "Cancelar Cita";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <div class="bg-white rounded-xl shadow-sm border border-red-200 overflow-hidden">
        <div class="bg-red-600 text-white px-5 py-4 flex items-center gap-2">
            <i class="fas fa-triangle-exclamation text-lg"></i>
            <h1 class="text-lg font-bold">Confirmar Cancelacion de Cita</h1>
        </div>

        <div class="p-5">

            <div class="flex items-start gap-3 bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg mb-5">
                <i class="fas fa-circle-exclamation mt-0.5"></i>
                <div>
                    <strong>Esta accion no se puede deshacer.</strong><br />
                    Al cancelar la cita, el medico sera notificado por correo electronico
                    y el horario quedara liberado automaticamente.
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg border border-gray-100 mb-5">
                <div class="px-4 py-2.5 border-b border-gray-100 font-semibold text-gray-700 text-sm flex items-center gap-2">
                    <i class="fas fa-calendar-xmark text-gray-400"></i> Cita que sera cancelada
                </div>
                <dl class="p-4 text-sm grid grid-cols-3 gap-y-2">
                    <dt class="col-span-1 text-gray-500">ID de la cita</dt>
                    <dd class="col-span-2 font-semibold text-gray-800">#@Model.AppointmentId</dd>

                    <dt class="col-span-1 text-gray-500">Paciente</dt>
                    <dd class="col-span-2 text-gray-800">@Model.PatientName</dd>

                    <dt class="col-span-1 text-gray-500">Doctor</dt>
                    <dd class="col-span-2 text-gray-800">Dr. @Model.DoctorName</dd>

                    <dt class="col-span-1 text-gray-500">Fecha</dt>
                    <dd class="col-span-2 text-gray-800">
                        <i class="fas fa-calendar-day text-gray-400"></i>
                        @Model.AppointmentDateFormatted
                    </dd>

                    <dt class="col-span-1 text-gray-500">Hora</dt>
                    <dd class="col-span-2 text-gray-800">
                        <i class="fas fa-clock text-gray-400"></i>
                        @Model.AppointmentTimeFormatted
                    </dd>

                    <dt class="col-span-1 text-gray-500">Estado actual</dt>
                    <dd class="col-span-2">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @Model.StatusBadgeClass">@Model.StatusName</span>
                    </dd>
                </dl>
            </div>

            <div class="bg-white rounded-lg border border-yellow-300 mb-5">
                <div class="px-4 py-2.5 border-b border-yellow-200 bg-yellow-50 font-semibold text-gray-700 text-sm flex items-center gap-2 rounded-t-lg">
                    <i class="fas fa-circle-info text-yellow-600"></i> Que ocurrira al confirmar
                </div>
                <ul class="divide-y divide-gray-100 text-sm">
                    <li class="flex items-center gap-2 px-4 py-2.5">
                        <i class="fas fa-circle-right text-red-500"></i>
                        El estado de la cita cambiara a <strong>Cancelada</strong>
                    </li>
                    <li class="flex items-center gap-2 px-4 py-2.5">
                        <i class="fas fa-circle-right text-red-500"></i>
                        El horario del medico quedara <strong>liberado automaticamente</strong>
                    </li>
                    <li class="flex items-center gap-2 px-4 py-2.5">
                        <i class="fas fa-circle-right text-red-500"></i>
                        Se enviara un correo de notificacion al <strong>medico y al paciente</strong>
                    </li>
                    <li class="flex items-center gap-2 px-4 py-2.5">
                        <i class="fas fa-circle-right text-red-500"></i>
                        Se registrara la fecha y hora exacta de la cancelacion
                    </li>
                </ul>
            </div>

            <div class="flex justify-between items-center">
                <a asp-action="Details" asp-route-id="@Model.AppointmentId"
                   class="inline-flex items-center gap-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition">
                    <i class="fas fa-arrow-left"></i> Volver sin cancelar
                </a>

                <form asp-action="CancelConfirmed" asp-route-id="@Model.AppointmentId"
                      method="post" id="cancelForm">
                    @Html.AntiForgeryToken()
                    <button type="button"
                            class="inline-flex items-center gap-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold py-2 px-5 rounded-lg transition"
                            onclick="confirmarCancelacion()">
                        <i class="fas fa-circle-xmark"></i> Si, cancelar esta cita
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarCancelacion() {
            const btn = document.querySelector('#cancelForm button');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelando...';
            document.getElementById('cancelForm').submit();
        }
    </script>
}
