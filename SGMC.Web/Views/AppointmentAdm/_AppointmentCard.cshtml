@model SGMC.Web.Models.Appointment.AppointmentListViewModel

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 mb-3">
    <div class="flex justify-between items-start">
        <div>
            <h5 class="font-semibold text-gray-800 flex items-center gap-2">
                <i class="fas fa-user text-blue-600"></i> @Model.PatientName
            </h5>
            <p class="text-sm text-gray-500 mt-1 flex items-center gap-2">
                <i class="fas fa-id-badge text-gray-400"></i> Dr. @Model.DoctorName
            </p>
            <p class="text-sm text-gray-600 mt-1 flex items-center gap-2">
                <i class="fas fa-calendar-day text-gray-400"></i> @Model.AppointmentDateFormatted
            </p>
        </div>
        <div>
            @await Html.PartialAsync("_StatusBadge", (Model.StatusId, Model.StatusName))
        </div>
    </div>
    <div class="mt-4 flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.AppointmentId"
           class="inline-flex items-center gap-1 bg-sky-500 hover:bg-sky-600 text-white text-xs font-semibold py-1.5 px-3 rounded-lg transition">
            <i class="fas fa-eye"></i> Ver
        </a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.AppointmentId"
               class="inline-flex items-center gap-1 bg-yellow-500 hover:bg-yellow-600 text-white text-xs font-semibold py-1.5 px-3 rounded-lg transition">
                <i class="fas fa-pen"></i> Editar
            </a>
        }
    </div>
</div>