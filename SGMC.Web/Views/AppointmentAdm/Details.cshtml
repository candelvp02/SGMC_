@model SGMC.Web.Models.Appointment.AppointmentDetailsViewModel

@{
    ViewData["Title"] = "Detalles de la Cita";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="bg-sky-500 text-white px-5 py-4 flex justify-between items-center">
            <h1 class="text-lg font-bold flex items-center gap-2">
                <i class="fas fa-calendar-check"></i> Detalles de la Cita
            </h1>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold @Model.StatusBadgeClass">@Model.StatusName</span>
        </div>

        <div class="p-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flex items-center gap-3 bg-green-50 border border-green-300 text-green-800 px-4 py-3 rounded-lg mb-4">
                    <i class="fas fa-check-circle text-green-500"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-4">
                    <i class="fas fa-triangle-exclamation text-red-500"></i> @TempData["ErrorMessage"]
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded-lg">
                    <i class="fas fa-triangle-exclamation text-red-500"></i> @ViewBag.ErrorMessage
                </div>
            }
            else
            {
                <!-- Información General -->
                <div class="bg-gray-50 rounded-lg border border-gray-100 mb-4">
                    <div class="px-4 py-2.5 border-b border-gray-100 font-semibold text-gray-700 text-sm flex items-center gap-2">
                        <i class="fas fa-circle-info text-gray-400"></i> Información General
                    </div>
                    <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        <dl class="space-y-2">
                            <div class="flex justify-between"><dt class="text-gray-500">ID Cita:</dt><dd class="font-semibold text-gray-800">@Model.AppointmentId</dd></div>
                            <div class="flex justify-between"><dt class="text-gray-500">Fecha:</dt><dd class="text-gray-800"><i class="fas fa-calendar-day text-gray-400"></i> @Model.AppointmentDateFormatted</dd></div>
                            <div class="flex justify-between"><dt class="text-gray-500">Hora:</dt><dd class="text-gray-800"><i class="fas fa-clock text-gray-400"></i> @Model.AppointmentTimeFormatted</dd></div>
                        </dl>
                        <dl class="space-y-2">
                            <div class="flex justify-between items-center"><dt class="text-gray-500">Estado:</dt><dd><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @Model.StatusBadgeClass">@Model.StatusName</span></dd></div>
                            <div class="flex justify-between"><dt class="text-gray-500">Creada el:</dt><dd class="text-gray-800">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</dd></div>
                            <div class="flex justify-between items-center">
                                <dt class="text-gray-500">Tipo:</dt>
                                <dd>
                                    @if (Model.IsFuture)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-800">Próxima</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">Pasada</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Información del Paciente -->
                <div class="bg-gray-50 rounded-lg border border-gray-100 mb-4">
                    <div class="px-4 py-2.5 border-b border-gray-100 font-semibold text-gray-700 text-sm flex items-center gap-2">
                        <i class="fas fa-user text-gray-400"></i> Información del Paciente
                    </div>
                    <div class="p-4 flex items-center justify-between text-sm">
                        <span class="font-semibold text-gray-800">@Model.PatientName</span>
                        <a asp-controller="PatientAdm" asp-action="Details" asp-route-id="@Model.PatientId"
                           class="inline-flex items-center gap-1 bg-white border border-sky-500 text-sky-600 hover:bg-sky-50 text-xs font-semibold py-1.5 px-3 rounded-lg transition">
                            <i class="fas fa-eye"></i> Ver perfil del paciente
                        </a>
                    </div>
                </div>

                <!-- Información del Doctor -->
                <div class="bg-gray-50 rounded-lg border border-gray-100 mb-4">
                    <div class="px-4 py-2.5 border-b border-gray-100 font-semibold text-gray-700 text-sm flex items-center gap-2">
                        <i class="fas fa-id-badge text-gray-400"></i> Información del Doctor
                    </div>
                    <div class="p-4 flex items-center justify-between text-sm">
                        <span class="font-semibold text-gray-800">Dr. @Model.DoctorName</span>
                        <a asp-controller="Doctor" asp-action="Details" asp-route-id="@Model.DoctorId"
                           class="inline-flex items-center gap-1 bg-white border border-sky-500 text-sky-600 hover:bg-sky-50 text-xs font-semibold py-1.5 px-3 rounded-lg transition">
                            <i class="fas fa-eye"></i> Ver perfil del doctor
                        </a>
                    </div>
                </div>

                <!-- Acciones -->
                <div class="bg-gray-50 rounded-lg border border-gray-100">
                    <div class="px-4 py-2.5 border-b border-gray-100 font-semibold text-gray-700 text-sm flex items-center gap-2">
                        <i class="fas fa-gear text-gray-400"></i> Acciones Disponibles
                    </div>
                    <div class="p-4 flex flex-col md:flex-row md:justify-between md:items-center gap-3">
                        <a asp-action="Index"
                           class="inline-flex items-center justify-center gap-1.5 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
                            <i class="fas fa-arrow-left"></i> Volver al Listado
                        </a>
                        <div class="flex flex-wrap gap-2">
                            @if (Model.CanConfirm)
                            {
                                <a asp-action="Confirm" asp-route-id="@Model.AppointmentId"
                                   class="inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition"
                                   onclick="return confirm('¿Está seguro de confirmar esta cita?');">
                                    <i class="fas fa-check-circle"></i> Confirmar Cita
                                </a>
                            }
                            @if (Model.CanReschedule)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.AppointmentId"
                                   class="inline-flex items-center gap-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
                                    <i class="fas fa-pen"></i> Editar
                                </a>
                            }
                            @if (Model.CanCancel)
                            {
                                <a asp-action="Cancel" asp-route-id="@Model.AppointmentId"
                                   class="inline-flex items-center gap-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
                                    <i class="fas fa-circle-xmark"></i> Cancelar Cita
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @if (Model.IsCancelled || Model.IsCompleted)
                {
                    <div class="flex items-center gap-3 bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg mt-4">
                        <i class="fas fa-circle-info text-yellow-600"></i>
                        Esta cita está en estado <strong>@Model.StatusName</strong> y no se puede modificar.
                    </div>
                }
            }
        </div>
    </div>
</div>
