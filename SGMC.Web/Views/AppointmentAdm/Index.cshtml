@using SGMC.Web.Models.Appointment
@model AppointmentIndexViewModel

@{
    ViewData["Title"] = "Gestión de Citas";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-10">

    <h1 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <i class="fas fa-calendar-check text-blue-600"></i> Gestión de Citas Médicas
    </h1>

    @* Mensajes de alerta *@
    @await Html.PartialAsync("_AlertMessage", ("success", (string?)TempData["SuccessMessage"]))
    @await Html.PartialAsync("_AlertMessage", ("danger", (string?)TempData["ErrorMessage"]))

    @if (ViewBag.ErrorMessage != null)

    {
        @await Html.PartialAsync("_AlertMessage", ("danger", (string)ViewBag.ErrorMessage))
    }

    <div class="mb-5">
        <a asp-action="Create"
           class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition">
            <i class="fas fa-plus"></i> Agendar Nueva Cita
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
        <div class="px-5 py-3 border-b border-gray-100 font-semibold text-gray-700 flex items-center gap-2">
            <i class="fas fa-filter text-gray-400"></i> Filtrar Citas
        </div>
        <div class="p-5">
            <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-4">
                    <label asp-for="Filter.PatientId" class="block text-sm font-semibold text-gray-700 mb-1">Paciente</label>
                    <select asp-for="Filter.PatientId" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" asp-items="@(new SelectList(Model.Patients, "PatientId", "DisplayText"))">
                        <option value="">-- Todos los Pacientes --</option>
                    </select>
                </div>
                <div class="md:col-span-4">
                    <label asp-for="Filter.DoctorId" class="block text-sm font-semibold text-gray-700 mb-1">Doctor</label>
                    <select asp-for="Filter.DoctorId" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" asp-items="@(new SelectList(Model.Doctors, "DoctorId", "DisplayText"))">
                        <option value="">-- Todos los Doctores --</option>
                    </select>
                </div>
                <div class="md:col-span-3">
                    <label asp-for="Filter.StatusId" class="block text-sm font-semibold text-gray-700 mb-1">Estado</label>
                    <select asp-for="Filter.StatusId" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" asp-items="@(new SelectList(Model.Statuses, "StatusId", "StatusName"))">
                        <option value="">-- Todos los Estados --</option>
                    </select>
                </div>
                <div class="md:col-span-1 flex items-end">
                    <button type="submit"
                            class="w-full inline-flex items-center justify-center bg-sky-500 hover:bg-sky-600 text-white py-2 rounded-lg transition">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Diseño de tarjetas *@
    @if (Model.Appointments != null && Model.Appointments.Any())
    {
        @foreach (var appointment in Model.Appointments)
        {
            @await Html.PartialAsync("_AppointmentCard", appointment)
        }
    }
    else
    {
        <div class="flex items-center gap-3 bg-sky-50 border border-sky-300 text-sky-800 px-4 py-3 rounded-lg">
            <i class="fas fa-info-circle text-sky-500 text-lg"></i>
            <span>No se encontraron citas con los filtros seleccionados.</span>
        </div>
    }
</div>